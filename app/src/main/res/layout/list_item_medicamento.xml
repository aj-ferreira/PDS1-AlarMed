<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:strokeColor="@color/gray_200"
        app:strokeWidth="1dp"
        android:backgroundTint="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner: Estoque baixo - topo do card, span total -->
            <LinearLayout
                android:id="@+id/badgeEstoqueBaixo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_banner_estoque_baixo"
                android:visibility="gone"
                tools:visibility="@sample/badge_visibilidade.txt">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/orange_500"
                    android:contentDescription="Alerta estoque baixo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Estoque baixo!"
                    android:textColor="@color/orange_500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Conteúdo principal do card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Seção superior: ícone + nome + subtítulo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Ícone / Imagem do medicamento -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/imageMedicamento"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_icon_medicamento"
                            android:contentDescription="Imagem do medicamento"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_icon_medicamento"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/iconMedicamento"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_comprimido"
                                app:tint="@color/secondary_text"
                                android:contentDescription="@string/pill_icon" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Nome e subtítulo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewNome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="@sample/medicamento_nomes.txt" />

                        <!-- Tipo · Dose na mesma linha -->
                        <TextView
                            android:id="@+id/badgeTipo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp"
                            android:textColor="@color/gray_600"
                            tools:text="@sample/medicamento_tipo.txt" />

                        <!-- Descrição opcional abaixo -->
                        <TextView
                            android:id="@+id/textViewDescricao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/gray_400"
                            android:visibility="gone"
                            tools:text="Descrição opcional" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Seção do meio: horário e estoque -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Horário e frequência -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_relogio"
                            app:tint="@color/gray_500"
                            android:contentDescription="Horário" />

                        <TextView
                            android:id="@+id/textViewHorario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/gray_600"
                            android:textSize="13sp"
                            tools:text="@sample/medicamento_horario.txt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=","
                            android:textColor="@color/gray_600"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textViewFrequencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/gray_500"
                            android:textSize="13sp"
                            tools:text="@sample/medicamento_frequencia.txt" />
                    </LinearLayout>

                    <!-- Estoque -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_comprimido"
                            app:tint="@color/primary_500"
                            android:contentDescription="Estoque" />

                        <TextView
                            android:id="@+id/textViewEstoque"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="13sp"
                            android:textColor="@color/gray_600"
                            tools:text="@sample/medicamento_estoque.txt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="unidades"
                            android:textSize="13sp"
                            android:textColor="@color/gray_500" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Espaçamento antes dos botões -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <!-- Seção inferior: botão Tomei + ações -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTomei"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/btn_medication_taken"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:backgroundTint="@color/green_500"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_check"
                        app:iconSize="16dp"
                        app:iconGravity="textStart" />

                    <ImageButton
                        android:id="@+id/btnEditar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_editar"
                        android:padding="10dp"
                        android:contentDescription="@string/btn_edit_medicine"
                        android:src="@drawable/ic_editar"
                        app:tint="@color/gray_600" />

                    <ImageButton
                        android:id="@+id/btnExcluir"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_excluir"
                        android:padding="10dp"
                        android:contentDescription="@string/btn_delete_medication"
                        android:src="@drawable/ic_lixeira"
                        app:tint="@color/red" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
