<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@android:color/white"
    android:elevation="8dp"
    android:gravity="center_vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerHistorico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/white"
        android:text="@string/btn_view_history"
        android:textColor="@color/gray_700"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_historico"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/gray_700"
        app:strokeWidth="1dp"
        app:strokeColor="@color/gray_300"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGerarPdf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:text="@string/btn_generate_pdf"
        android:textColor="@color/gray_700"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_relatorio"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/gray_700"
        app:strokeWidth="1dp"
        app:strokeColor="@color/gray_300"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

</LinearLayout>