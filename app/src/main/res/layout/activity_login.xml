<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo/Ícone do App -->
        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_logo_cadastro" />

        <!-- Título do App -->
        <TextView
            android:id="@+id/title_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/green_500"
            android:layout_marginBottom="8dp" />

        <!-- Subtítulo/Descrição do App -->
        <TextView
            android:id="@+id/subtitle_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_header_subtitle_app"
            android:textSize="14sp"
            android:textColor="@color/gray_600"
            android:layout_marginBottom="40dp"
            android:gravity="center" />

        <!-- Layout do Formulário de Login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Campo de Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="E-mail"
                android:textColorHint="@color/gray_600"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="@color/green_500"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#1A000000"
                app:boxCornerRadiusTopStart="28dp"
                app:boxCornerRadiusTopEnd="28dp"
                app:boxCornerRadiusBottomStart="28dp"
                app:boxCornerRadiusBottomEnd="28dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_600"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:minHeight="56dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo de Senha -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_senha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Senha"
                android:textColorHint="@color/gray_600"
                app:startIconDrawable="@android:drawable/ic_lock_lock"
                app:startIconTint="@color/green_500"
                app:endIconMode="password_toggle"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#1A000000"
                app:boxCornerRadiusTopStart="28dp"
                app:boxCornerRadiusTopEnd="28dp"
                app:boxCornerRadiusBottomStart="28dp"
                app:boxCornerRadiusBottomEnd="28dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_senha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_600"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:minHeight="56dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Link "Esqueci minha senha" -->

            <!-- Botão Entrar -->

            <TextView
                android:id="@+id/text_esqueceu_senha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="32dp"
                android:text="ESQUECI MINHA SENHA"
                android:textColor="@color/green_500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_entrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ENTRAR"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/green_500" />

        </LinearLayout>

        <!-- Link para Cadastro -->
        <TextView
            android:id="@+id/text_ir_para_cadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Não possui uma conta? Criar Conta"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/green_500" />

    </LinearLayout>
</ScrollView>